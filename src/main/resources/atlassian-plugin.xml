<?xml version="1.0" encoding="UTF-8"?>
<atlassian-plugin key="${atlassian.plugin.key}" name="${project.name}" plugins-version="2">
    <plugin-info>
        <description>${project.description}</description>
        <version>${project.version}</version>
        <vendor name="${project.organization.name}" url="${project.organization.url}"/>
    </plugin-info>

    <!-- Active Objects module: stores auto-assignment rules per project -->
    <ao key="autoassignment-ao-module">
        <description>Active Objects module for auto-assignment rules.</description>
        <entity>ru.gpb.jira.plugin.autoassignment.ao.AssignmentRule</entity>
    </ao>

    <!-- Project-level configuration servlet (rules) -->
    <servlet key="autoassignment-config-servlet" name="Auto Assignment Configuration Servlet"
             class="ru.gpb.jira.plugin.autoassignment.servlet.AssignmentConfigServlet">
        <url-pattern>/autoassignment/config</url-pattern>
    </servlet>

    <!-- Global (JIRA administrator) configuration servlet -->
    <servlet key="autoassignment-global-config-servlet" name="Auto Assignment Global Configuration Servlet"
             class="ru.gpb.jira.plugin.autoassignment.servlet.GlobalConfigServlet">
        <url-pattern>/autoassignment/global-config</url-pattern>
    </servlet>

    <!-- REST endpoints consumed by the configuration pages -->
    <rest key="autoassignment-rest" path="/autoassignment" version="1.0">
        <description>Auto Assignment configuration REST API.</description>
    </rest>

    <!-- Static web resources for the configuration pages -->
    <web-resource key="autoassignment-resources">
        <dependency>com.atlassian.auiplugin:ajs</dependency>
        <resource type="download" name="autoassignment.css" location="css/autoassignment.css"/>
        <resource type="download" name="autoassignment.js" location="js/autoassignment.js"/>
        <resource type="download" name="global-config.js" location="js/global-config.js"/>
    </web-resource>

    <!-- Link in the left panel of Project Settings -->
    <web-section key="autoassignment-project-section" name="Auto Assignment" location="atl.jira.proj.config" weight="50">
        <label>Auto Assignment</label>
    </web-section>
    <web-item key="autoassignment-project-settings-link" name="Auto Assignment"
              section="atl.jira.proj.config/autoassignment-project-section" weight="10">
        <label>Auto Assignment</label>
        <link linkId="autoassignment-project-settings-link">/plugins/servlet/autoassignment/config?projectKey=$projectKeyEncoded</link>
    </web-item>

    <!-- Link in the JIRA administration menu (global settings) -->
    <web-item key="autoassignment-admin-link" name="Auto Assignment" section="admin_plugins_menu" weight="100">
        <label>Auto Assignment</label>
        <link linkId="autoassignment-admin-link">/plugins/servlet/autoassignment/global-config</link>
    </web-item>
</atlassian-plugin>
